code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 WaveColor : source_color;
uniform vec2 speed;
uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_8;



void fragment() {
// ColorParameter:7
	vec4 n_out7p0 = WaveColor;


// Input:4
	float n_out4p0 = TIME;


// Vector2Parameter:6
	vec2 n_out6p0 = speed;


// VectorOp:5
	vec2 n_out5p0 = vec2(n_out4p0) * n_out6p0;


// UVFunc:3
	vec2 n_in3p1 = vec2(1.00000, 1.00000);
	vec2 n_out3p0 = n_out5p0 * n_in3p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out3p0);
	float n_out2p1 = n_out2p0.r;


// Texture2D:8
	vec4 n_out8p0 = texture(tex_frg_8, UV);
	float n_out8p1 = n_out8p0.r;


// FloatOp:9
	float n_out9p0 = n_out2p1 * n_out8p1;


// Output:0
	ALBEDO = vec3(n_out7p0.xyz);
	ALPHA = n_out9p0;


}
"
