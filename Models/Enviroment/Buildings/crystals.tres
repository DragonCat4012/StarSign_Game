[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;


// Varyings
varying vec3 WorldPos;

uniform sampler2D tex_frg_6;
uniform sampler2D tex_frg_10;
uniform sampler2D tex_frg_7 : hint_normal;
uniform sampler2D tex_frg_11 : hint_normal;
uniform sampler2D tex_frg_12;



void vertex() {
// Input:2
	mat4 n_out2p0 = MODEL_MATRIX;


// Input:3
	vec3 n_out3p0 = VERTEX;


// TransformVectorMult:4
	vec3 n_out4p0 = (n_out2p0 * vec4(n_out3p0, 1.0)).xyz;


// VaryingSetter:5
	WorldPos = n_out4p0;


}

void fragment() {
// VaryingGetter:4
	vec3 n_out4p0 = WorldPos;


// VectorDecompose:3
	float n_out3p0 = n_out4p0.x;
	float n_out3p1 = n_out4p0.y;
	float n_out3p2 = n_out4p0.z;


// Texture2D:6
	vec4 n_out6p0 = texture(tex_frg_6, vec2(n_out3p1));


// Texture2D:10
	vec4 n_out10p0 = texture(tex_frg_10, vec2(n_out3p2));


// Mix:8
	vec3 n_in8p2 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out8p0 = mix(vec3(n_out6p0.xyz), vec3(n_out10p0.xyz), n_in8p2);


// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, UV);
	float n_out7p1 = n_out7p0.r;


// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, 1.00000);
	vec2 n_in9p2 = vec2(0.00000, 1.00000);
	vec2 n_out9p0 = n_in9p2 * n_in9p1 + vec2(n_out7p1);


// Texture2D:11
	vec4 n_out11p0 = texture(tex_frg_11, UV);
	float n_out11p1 = n_out11p0.r;


// Texture2D:12
	vec4 n_out12p0 = texture(tex_frg_12, vec2(n_out11p1));


// Output:0
	ALBEDO = n_out8p0;
	ALPHA = n_out9p0.x;
	SPECULAR = n_out12p0.x;


}
